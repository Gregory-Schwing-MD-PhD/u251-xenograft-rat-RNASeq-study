// Host rnaseq/DE: containers on the CephFS cache; loaded after the repository's nextflow.config (slurm, -q primary).
singularity.cacheDir = '/rs/rs_grp_oschome/go2432/singularity_cache'
// Node-local /tmp is swept and can vanish mid-task: FastQC on N269B died writing its image cache there (job 40468032,
// "Can't create cache file!", /tmp/imageio*.tmp). Every container gets a CephFS directory as /tmp instead.
singularity.runOptions = '-B /rs/rs_grp_oschome/go2432/u251_host/tmp:/tmp'
