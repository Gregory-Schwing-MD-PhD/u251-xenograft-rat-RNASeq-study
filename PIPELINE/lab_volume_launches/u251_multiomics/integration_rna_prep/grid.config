// integration_rna_prep runs no Nextflow: no nf-core pipeline takes RNA-seq together with an Illumina methylation array,
// and this step is the RNA half of that integration. It is one SLURM job (run.sbatch) that calls two pinned containers
// with `singularity exec`:
//   R        depot.galaxyproject.org/singularity/bioconductor-deseq2:1.34.0--r41hc247a5b_3 (R 4.1; the image the
//            published nf-core/differentialabundance 1.5.0 run used for DESeq2); the script is base R only
//   samtools depot.galaxyproject.org/singularity/samtools:1.21--h50ea8bc_0
// run.sbatch looks for each image first in the shared cache below, then in /rs/rs_grp_oschome/go2432/singularity_cache
// (where both already are), and pulls into the shared cache only if neither holds it. Its md5 goes into summary.json.
//
// Resources are the #SBATCH lines of run.sbatch, sized to the work: -p reqp --qos=requeue --requeue, 4 CPU, 32 GB,
// 01:00:00. The largest step reads the 507 MB DepMap matrix into memory (about 3-4 GB in R); BAM md5 runs 4-way
// parallel in the background; the locus pass is 70 region queries. A local dry run of the R part took 3.5 min.
//
// This file exists so every folder under ANALYSIS/multiomics/ has the same shape; nothing passes it to Nextflow. If
// the step is ever wrapped as a Nextflow process, these are the settings it would use.
singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = '/rs/rs_grp_oschome/go2432/u251_multiomics/singularity'
  runOptions = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/integration/tmp:/tmp'   // node-local /tmp is swept
}
process {
  executor       = 'slurm'
  queue          = 'reqp'
  clusterOptions = '--qos=requeue'
  cpus           = 4
  memory         = 32.GB
  time           = 1.h
}
