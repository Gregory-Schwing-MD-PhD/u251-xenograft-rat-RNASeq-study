# invasion_niche grid settings, sourced by run.sbatch (bash). This item is custom R on released-pipeline outputs
# (nf-core/rnaseq 3.22.2 graft-only run and the host run); it launches no Nextflow, so this file carries the
# Singularity and resource settings a Nextflow grid.config would.

# Singularity 3.8.6 from the nextflow env (the same binary the rnaseq runs use)
SING=$HOME/mambaforge/envs/nextflow/bin/singularity
# shared image cache of the multi-omics build; images not there are used from the existing cache, never re-pulled
SING_CACHE=/rs/rs_grp_oschome/go2432/u251_multiomics/singularity
SING_CACHE_LEGACY=/rs/rs_grp_oschome/go2432/singularity_cache
# DESeq2 1.34.0 (+ ashr 2.2-54), R 4.1.3: the DESeq2 of nf-core/differentialabundance 1.5.0, which made the published
# human and host tables. Used for vst, the relabelling fits, parts A, B, D and the report.
DESEQ_IMG_NAME=depot.galaxyproject.org-singularity-bioconductor-deseq2-1.34.0--r41hc247a5b_3.img
# the lab's Bioconductor image (R 4.3.3, Bioconductor 3.18; fgsea 1.28.0, GSVA): part C. Not digest-pinned, so run.sbatch
# records its sha256.
SIF_NAME=go2432-bioconductor.sif
# R library for packages the image lacks (installed there only if missing, versions recorded)
RLIB=/rs/rs_grp_oschome/go2432/Rlib

# CephFS has no loop mounts here, so Singularity unpacks every image into a sandbox; it goes to /dev/shm (node RAM,
# removed on exit; node-local /tmp is swept and home is at 97 % of its quota). The 16 GB allocation covers the sif
# sandbox (a few GB) plus R (under 4 GB: 62,754 genes x 10 libraries; 200 thinning draws of ~10,000 genes).
SHM_BASE=/dev/shm

# resources (also in the #SBATCH lines of run.sbatch): reqp, --qos=requeue, 4 CPU, 16 GB, 2 h; expected run < 1 h.
# R uses SLURM_CPUS_PER_TASK for the DESeq2 fits (BiocParallel MulticoreParam) and fgsea.
