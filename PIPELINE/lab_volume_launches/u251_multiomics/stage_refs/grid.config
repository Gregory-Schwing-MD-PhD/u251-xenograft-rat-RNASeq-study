// stage_refs runs no Nextflow: run.sbatch is a plain Slurm job and calls its two containers with `singularity exec`.
// This file records the container settings that job uses, in the form the pipeline items load with -c, so that a
// pipeline launched later finds the bcftools image this job pulled instead of pulling another copy.

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    // what run.sbatch asks for: one task, network-bound
    cpus   = 4
    memory = 8.GB
    time   = 12.h
}

singularity {
    enabled    = true
    autoMounts = true
    // the existing CephFS cache (the item spec says to pull the bcftools image into it; rnaseq_graft uses it too).
    // The image is saved under Nextflow's own name for https://depot.galaxyproject.org/singularity/bcftools:1.21--h8b25389_0
    cacheDir   = '/rs/rs_grp_oschome/go2432/singularity_cache'
    // node-local /tmp is swept on this grid
    runOptions = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp'
}
