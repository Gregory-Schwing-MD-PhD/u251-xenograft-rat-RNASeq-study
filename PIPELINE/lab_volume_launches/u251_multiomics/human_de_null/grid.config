// human_de_null runs no Nextflow. run.sbatch is one plain Slurm job per pass and calls two images with
// `singularity exec`, by absolute path, from the existing CephFS cache; nothing is pulled:
//   DESeq2 step  /rs/rs_grp_oschome/go2432/singularity_cache/depot.galaxyproject.org-singularity-bioconductor-deseq2-1.34.0--r41hc247a5b_3.img
//                (the image nf-core/differentialabundance 1.5.0 ran DESEQ2_DIFFERENTIAL in: DESeq2 1.34.0, ashr 2.2-54)
//   fgsea step   /rs/rs_grp_oschome/go2432/singularity_cache/go2432-bioconductor.sif (R 4.3.3, fgsea 1.28.0; not
//                digest-pinned, so each run writes its sha256 to results/pass<X>/containers.tsv)
// This file exists so that every folder under ANALYSIS/multiomics/ has the same shape, and records the same settings
// in the form the pipeline items load with -c. No run passes it to Nextflow.

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    // what run.sbatch asks for, per pass: DESeq2 on 19,351 genes x 6 samples and fgsea over ~15,600 sets fit in this
    // with room; the host verification of the same code peaked well under it (job 40475691, 24G, about 10 min)
    cpus   = 4
    memory = 24.GB
    time   = 3.h
}

singularity {
    enabled    = true
    autoMounts = true
    // the container cache shared across the multiomics pipeline arms
    cacheDir   = '/rs/rs_grp_oschome/go2432/u251_multiomics/singularity'
    // node-local /tmp is swept on this grid; run.sbatch itself puts TMPDIR and XDG_RUNTIME_DIR under /dev/shm/<user>_<jobid>
    runOptions = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp -B /wsu/home/go/go24/go2432/u251-xenograft-murine-RNASeq-study -B /rs/rs_grp_oschome/go2432'
}
