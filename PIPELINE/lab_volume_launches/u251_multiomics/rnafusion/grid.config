// rnafusion on the WSU grid (nf-core/rnafusion 4.1.3, Nextflow 25.10.7). Loaded with -c on top of the pipeline's own
// configuration, so a withName block here changes only the keys it names (ext.prefix, publishDir stay the pipeline's).
// U/nextflow.config is deliberately not reused (it sends tasks to -q primary and sets a xengsort default container).

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    maxRetries     = 3
    // reqp is PreemptMode=REQUEUE: kill/pre-emption and out-of-memory codes are retried, anything else finishes the run
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    // largest reqp node types seen: 48 CPU / 256 GB (rgd), 40 CPU / 1.5 TB (mem); 24 CPU / 95 GB nodes also exist
    resourceLimits = [ cpus: 40, memory: 240.GB, time: 96.h ]

    // Arriba 2.5.0 -X: read identifiers (and transcript/peptide) also in fusions.discarded.tsv, so a CCLE marker that
    // Arriba discarded can be traced to the reads and the filter that removed it. The main fusions.tsv carries
    // read_identifiers by default.
    withName: 'ARRIBA_ARRIBA' {
        ext.args = '-X'
    }
    // C2B has 95.5 M pairs in the human file; the module passes 80 % of task memory as FusionCatcher's --Xmx
    withName: 'FUSIONCATCHER_FUSIONCATCHER' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = 48.h
    }
    // full GRCh38 index (SA 25 GB) + on-the-fly sjdb insertion + coordinate sort within STAR (--limitBAMsortRAM 0)
    withName: 'STAR_ALIGN' {
        memory = { 80.GB * task.attempt }
    }
    // the published run's Picard MarkDuplicates peaked at 81.8 GB with 200 GB allowed (heap follows the allocation);
    // the pipeline's process_low (2 CPU, 12 GB, 4 h) is too small for 95 M pairs with up to 50 multimappers kept
    withName: 'GATK4_MARKDUPLICATES' {
        cpus   = 4
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '20/1min'
}

singularity {
    enabled     = true
    autoMounts  = true
    // shared CephFS cache; rnafusion's images are not in it yet and are pulled on first use
    cacheDir    = '/rs/rs_grp_oschome/go2432/u251_multiomics/singularity'
    // node-local /tmp is swept (FastQC died there, job 40468032): every container gets a CephFS directory as /tmp
    runOptions  = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp'
    // FusionCatcher, FusionInspector, STAR-Fusion and the ctatsplicing docker image are large
    pullTimeout = '90 min'
}
