// rnavar on the WSU grid (nf-core/rnavar 1.3.0, Nextflow 25.10.7). Loaded with -c on top of the pipeline's own
// configuration. Written for this run; U/nextflow.config is deliberately not reused (it sends tasks to -q primary and
// sets a xengsort default container).

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    maxRetries     = 3
    // reqp is PreemptMode=REQUEUE: kill/pre-emption and out-of-memory codes are retried, anything else finishes the
    // run. Exception: the two libraries with almost no U251 reads (IL64B 314 k, N168B 435 k graft pairs) are kept for
    // description only, so a non-retryable failure in one of their tasks is ignored instead of stopping the run for
    // the other eight. The checks list every IGNORED task and mark that library partial. Processes without a meta
    // input (or with a meta without id) fall through to 'finish'.
    errorStrategy  = {
        if (task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 3) { return 'retry' }
        def small = false
        try { small = ((meta?.id ?: '').toString() ==~ /^(IL64B|N168B)_graft.*/) } catch (Throwable e) { small = false }
        return small ? 'ignore' : 'finish'
    }
    // largest reqp node types seen: 48 CPU / 256 GB (rgd), 40 CPU / 1.5 TB (mem); 24 CPU / 95 GB nodes also exist
    resourceLimits = [ cpus: 40, memory: 240.GB, time: 96.h ]

    // published human rnaseq run (same genome, same STAR): STAR_GENOMEGENERATE peaked at 64.8 GB
    withName: 'STAR_GENOMEGENERATE' {
        memory = { 80.GB * task.attempt }
    }
    // published human run: PICARD_MARKDUPLICATES peaked at 81.8 GB with 200 GB allowed (Picard's heap follows the
    // allocation, -Xmx = 0.8 x task.memory), so the peak measures the allowance, not the need
    withName: 'PICARD_MARKDUPLICATES' {
        memory = { 72.GB * task.attempt }
    }
    // process_single default is 6 GB / 4 h; one task per sample and interval (25 intervals)
    withName: 'GATK4_SPLITNCIGARREADS' {
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    // seq2HLA (bowtie against its bundled HLA reference) on up to 85 M pairs; process_medium gives 8 h.
    // A seq2HLA failure is ignored for every library: HLA is read from the eight large libraries only, and the checks
    // report any that is missing. It must not stop variant calling.
    withName: 'SEQ2HLA' {
        time          = { 12.h * task.attempt }
        errorStrategy = {
            (task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 3) ? 'retry' : 'ignore'
        }
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '20/1min'
}

singularity {
    enabled     = true
    autoMounts  = true
    // the shared CephFS image cache used by every item of this build (rnaseq_graft, stage_refs): the STAR image the
    // rat index was built with is already there
    cacheDir    = '/rs/rs_grp_oschome/go2432/singularity_cache'
    // node-local /tmp is swept (FastQC died there, job 40468032): every container gets a CephFS directory as /tmp
    runOptions  = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp'
    pullTimeout = '60 min'
}
