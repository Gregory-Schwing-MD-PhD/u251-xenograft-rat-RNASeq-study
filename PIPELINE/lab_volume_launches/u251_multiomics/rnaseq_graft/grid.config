// rnaseq_graft on the WSU grid (nf-core/rnaseq 3.22.2, Nextflow 25.10.2). Loaded with -c on top of the pipeline's own
// configuration. Written for this run; U/nextflow.config is deliberately not reused (it sends tasks to -q primary and
// sets a xengsort default container).

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    maxRetries     = 3
    // reqp is PreemptMode=REQUEUE: kill/pre-emption and out-of-memory codes are retried, anything else finishes the run
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    // largest reqp node types seen: 48 CPU / 256 GB (rgd), 40 CPU / 1.5 TB (mem); 24 CPU / 95 GB nodes also exist
    resourceLimits = [ cpus: 40, memory: 240.GB, time: 96.h ]

    // published human run peaks (pipeline_info/execution_trace_2026-05-13_10-48-53.txt): STAR_GENOMEGENERATE 64.8 GB,
    // PICARD_MARKDUPLICATES 81.8 GB (with 200 GB allowed; Picard's heap follows the allocation)
    withName: 'STAR_GENOMEGENERATE' {
        memory = 80.GB
    }
    withName: 'PICARD_MARKDUPLICATES' {
        memory = 100.GB
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '20/1min'
}

singularity {
    enabled     = true
    autoMounts  = true
    // the existing CephFS cache: it already holds the rnaseq 3.22.2 images the host run used
    cacheDir    = '/rs/rs_grp_oschome/go2432/singularity_cache'
    // node-local /tmp is swept (FastQC died there, job 40468032): every container gets a CephFS directory as /tmp
    runOptions  = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp'
    // the images the host run skipped (Picard, RSeQC, Qualimap, dupRadar) are pulled on first use
    pullTimeout = '60 min'
}
