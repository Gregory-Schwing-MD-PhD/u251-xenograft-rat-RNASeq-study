// rnasplice on the WSU grid (nf-core/rnasplice 1.0.4, Nextflow 23.10.0). Loaded with -c on top of the pipeline's own
// configuration. The common block of the multi-omics build, without process.resourceLimits (not a 23.10 setting; the
// caps are params max_cpus/max_memory/max_time in params.yaml). U/nextflow.config is deliberately not reused.

process {
    executor       = 'slurm'
    queue          = 'reqp'
    clusterOptions = '--qos=requeue'
    maxRetries     = 3
    // reqp is PreemptMode=REQUEUE: kill/pre-emption and out-of-memory codes are retried, anything else finishes the run
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }

    // process_high is 60 GB here; the published human STAR genomeGenerate peaked at 64.8 GB
    withName: 'STAR_GENOMEGENERATE' {
        memory = { [80.GB * task.attempt, 240.GB].min() }
    }
    // run_dexseq_exon.R and run_dexseq_dtu.R use DEXSeq's default SerialParam: one core does the work, so ask for 2
    // cores, not process_high's 12, and allow a long single-threaded fit
    withName: 'DEXSEQ_EXON|DEXSEQ_DTU' {
        cpus   = 2
        memory = { [64.GB * task.attempt, 240.GB].min() }
        time   = { [48.h * task.attempt, 96.h].min() }
    }
    // dexseq_count.py (HTSeq) is single-threaded and slow on 25-50 M position-sorted pairs
    withName: 'DEXSEQ_COUNT' {
        cpus   = 2
        memory = { [36.GB * task.attempt, 240.GB].min() }
        time   = { [24.h * task.attempt, 96.h].min() }
    }
    // suppa.py diffSplice is single-threaded
    withName: 'DIFFSPLICE_.*' {
        cpus   = 2
        memory = { [36.GB * task.attempt, 240.GB].min() }
        time   = { [24.h * task.attempt, 96.h].min() }
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '20/1min'
}

singularity {
    enabled     = true
    autoMounts  = true
    // the CephFS cache the nf-core pipelines of this round share (rnafusion uses the same directory)
    cacheDir    = '/rs/rs_grp_oschome/go2432/u251_multiomics/singularity'
    // node-local /tmp is swept (FastQC died there, job 40468032): every container gets a CephFS directory as /tmp
    runOptions  = '-B /rs/rs_grp_oschome/go2432/u251_multiomics/tmp:/tmp'
    pullTimeout = '60 min'
}
