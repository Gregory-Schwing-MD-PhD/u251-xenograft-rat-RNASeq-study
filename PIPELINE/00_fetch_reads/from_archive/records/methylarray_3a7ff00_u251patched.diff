@@ -32,6 +32,32 @@ force_epicv2_annotation <- function(rg, annotation_string) {
   rg
 }
 
+# u251 patch P1: set the annotation for the array minfi actually detected. Unpatched, the EPICv2
+# annotation was stamped onto every RGChannelSet inside try(silent=TRUE), so EPIC v1 intensities
+# were later indexed with the v2 manifest. A mismatch between the IDATs and --annotation now stops.
+set_annotation_for_array <- function(rg, annotation_string) {
+  arr <- annotation(rg)[["array"]]
+  say("minfi detected array:", arr, "| --annotation:", annotation_string)
+  if (identical(arr, "IlluminaHumanMethylationEPICv2")) {
+    return(force_epicv2_annotation(rg, annotation_string))
+  }
+  if (!identical(arr, "IlluminaHumanMethylationEPIC")) {
+    stop("Unsupported array type detected by minfi: ", arr)
+  }
+  if (!grepl("^ilm10b[0-9]+\\.hg(19|38)$", annotation_string)) {
+    stop("IDATs are EPIC v1 but --annotation is '", annotation_string,
+         "'. Use an EPIC v1 annotation, e.g. ilm10b4.hg19.")
+  }
+  annotation(rg) <- c(array = "IlluminaHumanMethylationEPIC", annotation = annotation_string)
+  pkg <- paste0("IlluminaHumanMethylationEPICanno.", annotation_string)
+  if (!requireNamespace(pkg, quietly = TRUE)) stop("Annotation package not installed: ", pkg)
+  if (!requireNamespace("IlluminaHumanMethylationEPICmanifest", quietly = TRUE)) {
+    stop("Manifest package not installed: IlluminaHumanMethylationEPICmanifest")
+  }
+  say("Annotation set to:", paste(annotation(rg), collapse = " / "))
+  rg
+}
