Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_18

# A pinned rebuild recipe for singularity_cache/go2432-bioconductor.sif, the hand-built image the R steps use
# (sha256 69485ffa6dfa7cd884ead560227e05725fce05cc7e5ca28faa024ea7c4ae9fe0, built 2026-09-26 07:03 EDT with
# singularity 3.8.6 from docker://go2432/bioconductor:latest, whose recipe is DOCKER/bioconductor.dockerfile).
#
# Why a second recipe: the Dockerfile installs from moving sources (the RELEASE_3_18 tag and CRAN's current
# packages), so building it again today gives other versions. Bioconductor 3.18 is frozen, so its packages come back
# the same; CRAN is read here from Posit's dated snapshot of the day before the image was built, and the last step
# compares every installed package's version with R_packages.tsv, the list read out of the original image, and fails
# the build on any difference. NOT YET BUILT: until a build passes that comparison the original image is the only
# proven copy and stays.
#
#   singularity build --fakeroot go2432-bioconductor.rebuilt.sif bioconductor_pinned.def

%files
    R_packages.tsv /opt/u251/R_packages.tsv

%post
    apt-get update && apt-get install -y libxml2-dev libssl-dev libcurl4-openssl-dev libpng-dev libjpeg-dev \
        libtiff-dev libfreetype6-dev libfribidi-dev libharfbuzz-dev libicu-dev zlib1g-dev libfontconfig1-dev cmake
    apt-get clean && rm -rf /var/lib/apt/lists/*
    R -e "options(repos = c(CRAN = 'https://packagemanager.posit.co/cran/2026-09-25')); \
      BiocManager::install(version = '3.18', ask = FALSE, update = FALSE); \
      want <- read.delim('/opt/u251/R_packages.tsv'); have <- rownames(installed.packages()); \
      BiocManager::install(setdiff(unique(want[['Package']]), have), ask = FALSE, update = FALSE)"
    R -e "want <- read.delim('/opt/u251/R_packages.tsv'); ip <- installed.packages(); \
      got <- ip[match(want[['Package']], ip[, 'Package']), 'Version']; bad <- want[is.na(got) | got != want[['Version']], ]; \
      if (nrow(bad)) { print(bad); quit(status = 1) }; cat('every package at the original version\n')"

%labels
    u251.recipe bioconductor_pinned.def
    u251.original_sha256 69485ffa6dfa7cd884ead560227e05725fce05cc7e5ca28faa024ea7c4ae9fe0
